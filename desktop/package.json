{
  "name": "artigo2md-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "verify:app": "codesign --verify --deep --strict --verbose=2 src-tauri/target/aarch64-apple-darwin/release/bundle/macos/artigo2md.app",
    "build:app": "tauri build --bundles app --target aarch64-apple-darwin && npm run verify:app"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@vscode/markdown-it-katex": "1.1.2",
    "dompurify": "3.5.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "svelte": "5.59.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.6",
    "@types/markdown-it": "14.2.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
